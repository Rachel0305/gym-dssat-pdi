# OS / editor
# ===============================
.DS_Store
.vscode/
.idea/

# Benchmark framework exceptions must follow the global *.csv rule above.
!benchmark_results/existing_results_registry.csv
!benchmark_results/result_registry.csv
!benchmark_results/**/summaries/*.csv
!benchmark_results/**/evaluations/season_summary.csv
!benchmark_results/**/evaluations/daily_trajectory.csv
